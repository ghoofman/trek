# Copy to .env (never committed). Generate with: openssl rand -hex 24
WAITLIST_DB_PASSWORD=

# Optional: email NOTIFY_TO about each beta sign-up. Any SMTP provider works.
# DigitalOcean blocks 25/465/587, so on the Droplet use Resend: SMTP_HOST=smtp.resend.com,
# SMTP_PORT=2587, SMTP_USER=resend, SMTP_PASS=<API key>, and a NOTIFY_FROM on a verified domain.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM=
NOTIFY_TO=
